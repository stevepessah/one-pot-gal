 has-aspect-ratio\n            \" style=\"\n                position: relative;\n                \n                  padding-bottom:125.39999389648438%;\n                \n                overflow: hidden;-webkit-mask-image: -webkit-radial-gradient(white, black);\n              \"\n              >\n                \n                \n                \n                \n                \n                \n                \n                <img data-stretch=\"false\" data-src=\"https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1587160470219-NL8F6XZ1V51X1KDOISED/Short+Rib+Mushroom+Ragu+Final+-+One+Pot+Gal.jpg\" data-image=\"https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1587160470219-NL8F6XZ1V51X1KDOISED/Short+Rib+Mushroom+Ragu+Final+-+One+Pot+Gal.jpg\" data-image-dimensions=\"500x627\" data-image-focal-point=\"0.5,0.5\" alt=\"Short Rib Mushroom Ragu Final - One Pot Gal.jpg\" data-load=\"false\" elementtiming=\"system-image-block\" data-sqsp-image-classic-block-image src=\"https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1587160470219-NL8F6XZ1V51X1KDOISED/Short+Rib+Mushroom+Ragu+Final+-+One+Pot+Gal.jpg\" width=\"500\" height=\"627\" alt=\"\" sizes=\"(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw\" style=\"display:block;object-fit: cover; width: 100%; height: 100%; object-position: 50% 50%\" onload=\"this.classList.add(&quot;loaded&quot;)\" srcset=\"https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1587160470219-NL8F6XZ1V51X1KDOISED/Short+Rib+Mushroom+Ragu+Final+-+One+Pot+Gal.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1587160470219-NL8F6XZ1V51X1KDOISED/Short+Rib+Mushroom+Ragu+Final+-+One+Pot+Gal.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1587160470219-NL8F6XZ1V51X1KDOISED/Short+Rib+Mushroom+Ragu+Final+-+One+Pot+Gal.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1587160470219-NL8F6XZ1V51X1KDOISED/Short+Rib+Mushroom+Ragu+Final+-+One+Pot+Gal.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1587160470219-NL8F6XZ1V51X1KDOISED/Short+Rib+Mushroom+Ragu+Final+-+One+Pot+Gal.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1587160470219-NL8F6XZ1V51X1KDOISED/Short+Rib+Mushroom+Ragu+Final+-+One+Pot+Gal.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1587160470219-NL8F6XZ1V51X1KDOISED/Short+Rib+Mushroom+Ragu+Final+-+One+Pot+Gal.jpg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-yui_3_17_2_1_1581877650651_13072\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\"><strong>RECIPE | SHORT RIB MUSHROOM RAGU</strong></p><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Ingredients:</strong></p><ul data-rte-list=\"default\"><li><p class=\"\" style=\"white-space:pre-wrap;\">4lbs short rib on the bone</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Bacon fat or olive oil</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Salt and pepper</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">2 carrots, peeled and coarsely chopped&nbsp;</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">1 small yellow onion, coarsely chopped&nbsp;</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">2 celery stalks, coarsely chopped&nbsp;</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">2 sprigs fresh thyme (or 2 tsp dried)</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">1 sprig fresh rosemary (or 1 tsp dried)</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">1 sprig fresh oregano (or 1 tsp dried)</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">1 bay leaf</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">1 cup red wine</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">4 tablespoons butter</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">1 tablespoon Worcestershire sauce</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">1 container baby bella mushrooms, rinsed and sliced</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">1 quart beef broth</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">1 28 oz can San Marzano crush tomatoes</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Flour for coating the short ribs</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Good quality parmesan cheese (grate it yourself, it’s better that way!)</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Pappardelle pasta (or any noodle of your choice, I think this goes nicely with an egg noodle, a pappardelle, bucatini, or a fettuccine would work)</p></li></ul><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Instructions:</strong></p><ol data-rte-list=\"default\"><li><p class=\"\" style=\"white-space:pre-wrap;\">Generously season the short ribs with salt and pepper. Add flour to a shallow bowl or plate, and lightly coat the short ribs in flour, making sure each side is covered.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">In a heavy skillet (I use cast iron) bring the pan to high heat. If you have bacon, throw a couple pieces on and use the grease to sear your ribs. If not, use a good quality olive oil.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Sear the ribs on all sides until browned with a crust. It will take a few minutes per side - use tongs to help get a 360 degree sear on all sides.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Add the meat, red wine, onion, carrot, celery, garlic, herbs, beef broth, tomatoes, and bay leaf to the crockpot. Cover and cook on high for 4-5 hours (or low 6-8 hours).</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Remove the meat and toss the bones. Shred and set aside.&nbsp;</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Remove the bay leaf and herbs.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Use a spoon to skim off any excess fat that rises to the top (if you make this ahead you can put in the fridge and the fat will solidify overnight and will be easy to scrape off)</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Using an immersion hand blender, puree the sauce until smooth. Add the butter and ½ cup fresh grated parmesan cheese and swirl it together. Adjust for salt and pepper.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">In a saucepan, sautee the mushrooms in butter.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Add the mushrooms and the meat back to the sauce.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Salt a pot of water and bring to a boil. Boil the pasta according to the package instructions and drain once it’s al dente.&nbsp;</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Toss the pasta into the sauce until evenly incorporated.&nbsp;</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Serve with crusty bread, more parmesan for topping, and a glass of red wine! </p></li></ol><p class=\"\" data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\"></p><p class=\"\" data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\"></p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</div></div></div></div></div>",
  "seo": {}
}
