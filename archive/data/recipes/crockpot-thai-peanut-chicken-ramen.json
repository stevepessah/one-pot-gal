x-width: 767px) 50vw, 50vw\" style=\"display:block;object-fit: cover; width: 100%; height: 100%; object-position: 50% 50%\" onload=\"this.classList.add(&quot;loaded&quot;)\" srcset=\"https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1589209319582-GIQG1BTY0PYLL7OG7BOV/IMG_8299.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1589209319582-GIQG1BTY0PYLL7OG7BOV/IMG_8299.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1589209319582-GIQG1BTY0PYLL7OG7BOV/IMG_8299.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1589209319582-GIQG1BTY0PYLL7OG7BOV/IMG_8299.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1589209319582-GIQG1BTY0PYLL7OG7BOV/IMG_8299.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1589209319582-GIQG1BTY0PYLL7OG7BOV/IMG_8299.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5da7d49f6a98d112691e4bbc/1589209319582-GIQG1BTY0PYLL7OG7BOV/IMG_8299.jpg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div></div><div class=\"col sqs-col-3 span-3\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/3399b973-9dd2-4804-8498-7f08111b52b6_1297/website.components.spacer.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/3399b973-9dd2-4804-8498-7f08111b52b6_1297/website.components.spacer.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.spacer\" data-website-component-id=\"yui_3_17_2_1_1589210468487_35725\" id=\"block-yui_3_17_2_1_1589210468487_35725\"><div class=\"sqs-block-content\">&nbsp;</div></div></div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-yui_3_17_2_1_1589206537271_33166\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">So two things: I had leftover chicken that I shredded and used for this, which is what you see in the photos. For your purposes, you would add the raw chicken breast directly to the crockpot.</p><p class=\"\" style=\"white-space:pre-wrap;\">I also didn’t have fish sauce so I substituted 1 tablespoon rice wine vinegar (white wine vinegar would work too) + 1 tablespoon soy sauce. If you have fish sauce though - use it. It adds great umami flavor to this dish (and no, it doesn’t make the broth taste fishy). I like the brand Red Boat - you can buy on <a href=\"https://www.amazon.com/Red-Boat-Premium-Fish-Sauce/dp/B00B617XK2\" target=\"_blank\">Amazon</a>.</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</div></div><div class=\"row sqs-row\"><div class=\"col sqs-col-3 span-3\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/3399b973-9dd2-4804-8498-7f08111b52b6_1297/website.components.spacer.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/3399b973-9dd2-4804-8498-7f08111b52b6_1297/website.components.spacer.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.spacer\" data-website-component-id=\"yui_3_17_2_1_1589210468487_38182\" id=\"block-yui_3_