  "bodyHtml": "<div class=\"sqs-layout sqs-grid-12 columns-12\" data-type=\"page\" data-updated-on=\"1587222717107\" id=\"page-5da7d49f6a98d112691e4ca8\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"row sqs-row\"><div class=\"col sqs-col-1 span-1\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/3399b973-9dd2-4804-8498-7f08111b52b6_1297/website.components.spacer.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/3399b973-9dd2-4804-8498-7f08111b52b6_1297/website.components.spacer.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.spacer\" data-website-component-id=\"9ce62e357a58aede358c\" id=\"block-9ce62e357a58aede358c\"><div class=\"sqs-block-content\">&nbsp;</div></div></div><div class=\"col sqs-col-10 span-10\"><div class=\"row sqs-row\"><div class=\"col sqs-col-9 span-9\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-5e94918a036f54bca32a\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <h1 style=\"white-space:pre-wrap;\">rustic cooking with extra love</h1>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</div></div></div><div class=\"col sqs-col-1 span-1\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/3399b973-9dd2-4804-8498-7f08111b52b6_1297/website.components.spacer.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/3399b973-9dd2-4804-8498-7f08111b52b6_1297/website.components.spacer.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.spacer\" data-website-component-id=\"b8d09ffde9bd466c043f\" id=\"block-b8d09ffde9bd466c043f\"><div class=\"sqs-block-content\">&nbsp;</div></div></div></div><div class=\"row sqs-row\"><div class=\"col sqs-col-6 span-6\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-ff63de1c329d307b22aa\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <h3 style=\"white-space:pre-wrap;\">I’m a one pot kinda gal…</h3><p class=\"\" style=\"white-space:pre-wrap;\">Welcome to <strong>one pot gal</strong>, a blog by me, Kathleen. I love to cook, I love to host, and I LOVE an easy one pot meal to bring together family and friends. I’m a full-time working mom (previously NYC based but new to the burbs in Jersey!) and a wife to the love of my life Steve, who encouraged me to start this blog. Entertaining has always been my favorite thing to do. There is nothing better than gathering family and friends and filling wine glasses, talking and laughing over a cheeseboard, and making everyone feel comfortable, happy, and well fed. :) To me, the coziest homes are the ones with a bustling kitchen, a revolving door of houseguests, plenty of throw blankets and areas to cozy up, and of course -- comforting, approachable, delicious food.</p><p class=\"\" style=\"white-space:pre-wrap;\">So please enjoy one pot gal, where I will be posting lots of recipes and I’m sure an obnoxious amount of pictures of my baby boy aka light of my life, Sammy! Boop! &nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\"><a href=\"https://www.instagram.com/onepotgal\">@onepotgal</a> on Instagram</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</div></div></div><div class=\"col sqs-col-3 span-3\"><div class=\"sqs-block i