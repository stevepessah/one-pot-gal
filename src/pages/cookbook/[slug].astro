---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PrintButton from "../../components/PrintButton.astro";
import RecipeJsonLd from "../../components/RecipeJsonLd.astro";
import { byBookOrder, cookId, cookbookImage, isCookbookRecipe } from "../../lib/content";
import { plainLead, recipeJsonLd } from "../../lib/recipe-schema";

export async function getStaticPaths() {
  const entries = await getCollection("cookbook");
  const recipes = entries.filter(isCookbookRecipe).sort(byBookOrder);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      related: entry.data.author
        ? recipes
            .filter((recipe) => recipe.id !== entry.id && recipe.data.author === entry.data.author)
            .slice(0, 3)
        : [],
    },
  }));
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const byline = [entry.data.author, entry.data.credit].filter(Boolean).join(" · ");
const eyebrow = [entry.data.section, entry.data.part].filter(Boolean).join(" · ");
const image = cookbookImage(entry.data.images?.[0]);
const description = plainLead(entry.body, `${entry.data.title}${entry.data.author ? `, from ${entry.data.author}` : ""}`);
const schema = isCookbookRecipe(entry)
  ? recipeJsonLd({
      title: entry.data.title,
      description,
      body: entry.body,
      author: entry.data.author,
      image,
    })
  : undefined;
if (isCookbookRecipe(entry) && !schema) console.warn(`No recipe schema: cookbook/${entry.id}`);
---

<Base title={entry.data.title} description={description} image={image} type="article">
  <RecipeJsonLd data={schema} />
  <article class="article">
    <header class="article-head">
      <div class="article-tools">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <PrintButton />
      </div>
      <h1>{entry.data.title}</h1>
      {byline && <p class="byline">{byline}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
    {
      related.length > 0 && entry.data.author && (
        <section class="related no-print">
          <h2>More from {entry.data.author}</h2>
          <ul>
            {related.map((recipe) => (
              <li>
                <a href={`/cookbook/${recipe.id}`}>{recipe.data.title}</a>
              </li>
            ))}
          </ul>
          <a class="text-link" href={`/cookbook/cooks#${cookId(entry.data.author)}`}>
            All from {entry.data.author}
          </a>
        </section>
      )
    }
  </article>
</Base>
