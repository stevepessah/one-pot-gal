---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import RecipeCard from "../components/RecipeCard.astro";
import { blogImage, byPublishedDesc } from "../lib/content";

const recipes = (await getCollection("recipes")).sort(byPublishedDesc);
const recent = recipes.slice(0, 4);
const coverPhotos = [
  { src: "/media/brand/cookbook-cover-1.jpg", alt: "A vintage family portrait from the cookbook cover" },
  { src: "/media/brand/cookbook-cover-2.jpg", alt: "The family gathered at Christmas, from the cookbook cover" },
  { src: "/media/brand/cookbook-cover-3.jpg", alt: "The family together in a living room, from the cookbook cover" },
];
---

<Base title="one pot gal">
  <section class="hero">
    <div class="hero-copy">
      <h1>one pot gal</h1>
      <p>cooking the most tasty, cozy, and delicious food that one pot can offer</p>
    </div>
  </section>

  <div class="page">
    <div class="section-head">
      <h2>Recent recipes</h2>
      <a class="text-link" href="/recipes">All recipes</a>
    </div>
    <div class="story-grid">
      {
        recent.map((recipe) => (
          <RecipeCard
            href={`/recipes/${recipe.id}`}
            title={recipe.data.title}
            excerpt={recipe.data.excerpt}
            image={blogImage(recipe.data.image)}
          />
        ))
      }
    </div>

    <section class="cookbook-panel">
      <div class="cookbook-copy">
        <p class="eyebrow">The family cookbook</p>
        <h2>Hungry, Hungry Hobans</h2>
        <p>
          This book was cooked up by our kids to honor our family’s delicious culinary traditions, as well as some new additions.
        </p>
        <a class="text-link" href="/cookbook">Browse the cookbook</a>
      </div>
      <div class="cookbook-photos">
        {coverPhotos.map((photo) => <img src={photo.src} alt={photo.alt} />)}
      </div>
    </section>
  </div>
</Base>
